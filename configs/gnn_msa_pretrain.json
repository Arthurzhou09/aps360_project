{
  "seed": 1012,

  "model": {
    "node_in_channels": 38,
    "edge_features_dim": 128,
    "hidden_channels": 64,
    "head_hidden_channels": 64,
    "mp_layers": 2,
    "head_layers": 2,
    "dropout": 0.1,
    "encoder_rounds": 1,
    "decoder_rounds": 1
  },

  "train": {
    "lr": 0.0005,
    "epochs": 30,
    "weight_decay": 0.01,
    "warmup_epochs": 2,
    "min_lr_factor": 0.05,
    "grad_clip": 1.0,
    "patience": 8
  },

  "data": {
    "neighbours": 12,
    "shuffle": true,
    "num_workers": 0,
    "train_size": 0.8,
    "val_size": 0.1,
    "batch_size": 32,
    "mask_ratio": 0.3
  },

  "logging": {
    "output_dir": "./src/train/gnn/output_msa"
  }
}
