{
  "seed": 1012,
  "model": {
    "node_in_channels": 57,
    "edge_features_dim": 128,
    "hidden_channels": 64,
    "reg_hidden_channels": 32,
    "mp_layers": 3,
    "head_layers": 2,
    "dropout": 0.3
  },
  "train": {
    "lr": 0.0005,
    "epochs": 100,
    "weight_decay": 0.01,
    "warmup_epochs": 3,
    "min_lr_factor": 0.05,
    "grad_clip": 1.0,
    "patience": 15,
    "loss": "mse",
    "group_balance": true
  },
  "data": {
    "neighbours": 20,
    "shuffle": true,
    "num_workers": 0,
    "train_size": 0.8,
    "val_size": 0.1,
    "n_blocks": 20,
    "batch_size": 64
  },
  "logging": {
    "output_dir": "./src/train/gnn/output_new"
  }
}