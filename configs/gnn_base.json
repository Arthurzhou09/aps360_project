{
  "seed": 1012,

  "model": {
    "in_channels": 128,
    "hidden_channels": 64,
    "reg_hidden_channels": 32,
    "mp_layers": 3,
    "head_layers": 2,
    "dropout": 0.1
  },

  "train": {
    "lr": 0.001,
    "epochs": 1,
    "weight_decay": 0.00001
  },

  "data": {
    "neighbours": 20,
    "shuffle": true,
    "num_workers": 4,
    "train_size":0.8,
    "val_size":0.1,
    "batch_size": 32
  },

  "logging": {
    "output_dir": "logs",
    "log_every": 10
  }
}
