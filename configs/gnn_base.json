{
  "seed": 1012,

  "model": {
    "node_in_channels": 3, 
    "edge_features_dim": 128,
    "hidden_channels": 64,
    "reg_hidden_channels": 32,
    "mp_layers": 3,
    "head_layers": 2,
    "dropout": 0.1
  },

  "train": {
    "lr": 0.001,
    "epochs": 1,
    "weight_decay": 0.00001
  },

  "data": {
    "neighbours":16,
    "shuffle": true,
    "num_workers": 4,
    "train_size":0.8,
    "val_size":0.1,
    "batch_size": 32
  },

  "logging": {
    "output_dir": "./src/train/gnn/output"
  }
}